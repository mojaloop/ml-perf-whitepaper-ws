*_tmp
kubeconfig-*
*.log
.DS_Store
# Top-level _-prefixed dirs (_ext-rs/, _legacy/, _test/) — root-only, not nested.
/_*

# Local secrets — root .env (scenario-agnostic). Template lives at .env.example.
/.env

# Generated mTLS cert Secrets — private key material, regenerate locally with
# certs/regen-certs.sh (never commit the output; see docs/mtls.md).
/certs/switch-tls-secret.yaml
/certs/dfsp-tls-secret.yaml

# Per-scenario generated artifacts — terraform inventory/ssh-config, kubeconfigs,
# rendered manifests, cloned helm charts, hostaliases. All regenerated by
# `make terraform-apply` + `make k8s`; never source-of-truth.
scenarios/*/artifacts/
phase1/*/artifacts/
phase1/*/*-artifacts/

# Local Claude Code config + reference-only scratch material — not repo content.
/.claude/
/CLAUDE/
/memory/
/CLAUDE.md

# Editor-local settings.
/.vscode/

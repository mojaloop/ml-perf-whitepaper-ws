*_tmp
kubeconfig-*
*.log
.DS_Store
# Top-level _-prefixed dirs (_ext-rs/, _legacy/, _test/) — root-only, not nested.
/_*

# Local secrets — root .env (scenario-agnostic). Template lives at .env.example.
/.env

# Per-scenario generated artifacts — terraform inventory/ssh-config, kubeconfigs,
# rendered manifests, cloned helm charts, hostaliases. All regenerated by
# `make terraform-apply` + `make k8s`; never source-of-truth.
scenarios/*/artifacts/

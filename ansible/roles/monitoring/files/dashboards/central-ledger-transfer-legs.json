    {
      "type": "timeseries",
      "title": "Transfer Prepare \u2014 processing time p95, by leg",
      "description": "Three-layer breakdown of transfer-prepare processing time: Kafka-handler ingress -> domain logic -> DB model layer. Isolates which layer contributes the most latency.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(moja_transfer_prepare_bucket[$__rate_interval])))",
          "legendFormat": "handler ingress",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(moja_domain_transfer_bucket{funcName=\"prepare\"}[$__rate_interval])))",

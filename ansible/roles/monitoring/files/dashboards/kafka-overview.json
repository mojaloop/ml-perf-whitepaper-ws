{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Consumer lag by topic \u2014 validity-gate topics",
      "description": "The topics steady-state.sh checks for the pass/fail validity gate (fulfil/prepare=1.0, notif/prepare=2.0). Rising lag on any of these is the leading indicator of backpressure/collapse \u2014 this was the dominant failure signature across every prior investigation in this campaign.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{topic=~\"topic-transfer-prepare|topic-transfer-fulfil|topic-notification-event|topic-transfer-position-batch|topic-quotes-post\", consumergroup!=\"cs-group-centralsettlement-handler-rules-notification-event\"})",
          "legendFormat": "{{consumergroup}} ({{topic}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Message rate by topic \u2014 validity-gate topics",
      "description": "Should hold flat at the target rate (500/s prepare+fulfil, 1000/s notification, 500/s quotes-post at 500 TPS) \u2014 a topic falling below target while others hold steady is the first sign of a stuck consumer group.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "clamp_min(sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"topic-transfer-prepare|topic-transfer-fulfil|topic-notification-event|topic-transfer-position-batch|topic-quotes-post\"}[$__rate_interval])), 0)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Partition count by topic \u2014 validity-gate topics",
      "description": "Direct catch for this campaign's recurring landmine: auto.create.topics.enable + ephemeral storage means ANY kafka restart can silently recreate a topic at 1 partition, stranding all-but-one consumer replica. A sudden drop in any topic's line is that exact failure \u2014 not a query problem, a real broker-state problem.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (topic) (kafka_topic_partitions{topic=~\"topic-transfer-prepare|topic-transfer-fulfil|topic-notification-event|topic-transfer-position-batch|topic-quotes-post\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer group members by group",
      "description": "Consumer replica count per group actively registered with the broker \u2014 a drop here (without a corresponding deploy scale-down) means pods are failing to join/rejoin the group, the other half of the auto-create-at-1-partition failure mode.",
      "datasource": {

  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Query throughput by command",
      "description": "Read/write mix, straight from MySQL's own command counters \u2014 should track the transfer prepare/fulfil rate almost exactly (each transfer = ~1 select + 1 insert/update + begin + commit).",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (command) (rate(mysql_global_status_commands_total{command=~\"select|insert|update|delete|begin|commit|insert_select\"}[$__rate_interval]))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Row access pattern (handler operations)",
      "description": "handler_read_key = index lookups (good). handler_read_rnd_next = full table/range scans without an index (watch this relative to read_key \u2014 a rising ratio means queries are scanning instead of seeking, usually a missing index or a query planner regression).",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (handler) (rate(mysql_global_status_handlers_total{handler=~\"read_key|read_next|read_prev|read_rnd_next|write|update|commit\"}[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "InnoDB redo log activity (durability cost)",
      "description": "Direct evidence of the innodb_flush_log_at_trx_commit=2 / sync_binlog=0 tuning this campaign relies on for throughput: log writes happen every commit, but OS fsyncs are decoupled (roughly once/sec) instead of once per commit \u2014 this ratio is WHY the relaxed durability setting buys throughput, and the actual risk window (up to ~1s of commits) if the broker crashes.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_innodb_log_writes[$__rate_interval])",
          "legendFormat": "log writes/s",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_innodb_os_log_fsyncs[$__rate_interval])",
          "legendFormat": "log fsyncs/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "InnoDB physical disk I/O",
      "description": "Actual physical disk I/O (distinct from buffer-pool logical reads below) \u2014 reads/s should stay low if the working set fits in the buffer pool.",

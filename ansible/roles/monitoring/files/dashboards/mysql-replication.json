  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "mysql",
    "datastore",
    "whitepaper"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "title": "MySQL Replication",
  "uid": "mysql-replication",
  "version": 1,
  "description": "Semi-sync replication health for the primary/secondary pair: thread state, lag, relay-log backlog, and the semi-sync durable-ack path (fallbacks to async, per-commit ack wait). The p99 latency results are only valid while \"async fallbacks\" stays flat at zero.",
  "panels": [
    {
      "type": "timeseries",
      "title": "Replication threads running (secondary)",
      "description": "Both must read 1. IO thread receives the primary's binlog into the relay log (semi-sync acks on this); SQL thread applies it. SQL=0 with IO=1 is a stuck applier \u2014 relay log grows without bound, durability still intact.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "max": 1.2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_replica_io_running",
          "legendFormat": "IO thread",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_replica_sql_running",
          "legendFormat": "SQL thread",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replica lag \u2014 Seconds_Behind_Source",
      "description": "Wall-clock lag of the SQL thread. Reads 0 when caught up. NULL (missing series) while the SQL thread is stopped \u2014 cross-check the threads panel above.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_seconds_behind_source",
          "legendFormat": "seconds behind",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Relay log \u2014 received vs applied (bytes/s)",
      "description": "Binlog byte rate into the relay log vs out of it. Tracking = replica keeping up. Applied sustained below received = falling behind (lag will grow). Brief gaps at binlog-file rotation are expected (position counter resets).",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_slave_status_read_source_log_pos[$__rate_interval])",
          "legendFormat": "received (IO thread)",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_slave_status_exec_source_log_pos[$__rate_interval])",
          "legendFormat": "applied (SQL thread)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Relay log space on disk",
      "description": "Total un-purged relay log. Flat/small = healthy. Monotonic growth = SQL thread not draining what the IO thread receives (a stuck or slow applier).",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_relay_log_space",
          "legendFormat": "relay_log_space",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replication error codes",
      "description": "0 = healthy. 1236 = IO thread lost its position on the primary (binlog purged). 1032/1062 = SQL thread hit a row that a gap-skip left inconsistent. Any nonzero here means replication has stopped.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_last_io_errno",
          "legendFormat": "Last_IO_Errno",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_last_sql_errno",
          "legendFormat": "Last_SQL_Errno",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Semi-sync engaged",
      "description": "source status must be 1 and clients >= 1. If status drops to 0 the primary has timed out waiting for the replica and disabled semi-sync \u2014 every commit since is async until it re-engages.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "max": 2.2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_status_rpl_semi_sync_source_status",
          "legendFormat": "source status (primary, 1=ON)",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_status_rpl_semi_sync_source_clients",
          "legendFormat": "connected semi-sync replicas",
          "refId": "B"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_status_rpl_semi_sync_replica_status",
          "legendFormat": "replica status (secondary, 1=ON)",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Semi-sync \u2014 durable acks vs async fallbacks (per second)",
      "description": "THE durability gate. yes_tx/s should equal the commit rate; no_tx/s must stay flat at zero. Any sustained no_tx means commits are being released without a replica ack \u2014 the p99 result for that window is not a durable-mode measurement.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_rpl_semi_sync_source_yes_tx[$__rate_interval])",
          "legendFormat": "acked before commit (yes_tx/s)",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_rpl_semi_sync_source_no_tx[$__rate_interval])",
          "legendFormat": "fell back to async (no_tx/s)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Semi-sync \u2014 per-commit wait for replica ack",
      "description": "Latency semi-sync adds to every commit on the primary: the time from a commit entering the wait to the replica's ack. Baseline here is well under 1 ms. 'sessions blocked' spiking above ~0 means the replica has become the commit-path bottleneck.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_rpl_semi_sync_source_tx_wait_time[$__rate_interval]) / clamp_min(rate(mysql_global_status_rpl_semi_sync_source_tx_waits[$__rate_interval]), 1) / 1000",
          "legendFormat": "avg ack wait (ms, windowed)",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_rpl_semi_sync_source_net_wait_time[$__rate_interval]) / clamp_min(rate(mysql_global_status_rpl_semi_sync_source_net_waits[$__rate_interval]), 1) / 1000",
          "legendFormat": "avg network round-trip (ms, windowed)",
          "refId": "B"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_status_rpl_semi_sync_source_wait_sessions",
          "legendFormat": "sessions currently blocked on ack",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Primary vs secondary \u2014 commit rate",
      "description": "The secondary applies serially (replica_preserve_commit_order), so it can't use group commit. If its commit rate can't match the primary's, lag grows \u2014 this is why the secondary runs sync_binlog=1000 while the primary runs 1.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_commands_total{command=\"commit\",pod=\"mysqldb-primary-0\"}[$__rate_interval])",
          "legendFormat": "primary commits/s",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(mysql_global_status_commands_total{command=\"commit\",pod=\"mysqldb-secondary-0\"}[$__rate_interval])",
          "legendFormat": "secondary commits/s (apply)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Config reference (current values)",
      "description": "Flat lines \u2014 the replication settings behind this result. sync_binlog reads 1 on the primary, 1000 on the secondary (deliberate asymmetry). source_timeout 1000 ms bounds the commit stall before an async fallback.",
      "datasource": {
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_variables_sync_binlog",
          "legendFormat": "sync_binlog {{pod}}",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_variables_rpl_semi_sync_source_timeout",
          "legendFormat": "semi_sync source_timeout (ms)",
          "refId": "B"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_variables_rpl_semi_sync_source_wait_for_replica_count",
          "legendFormat": "wait_for_replica_count",
          "refId": "C"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_variables_gtid_mode",
          "legendFormat": "gtid_mode {{pod}}",
          "refId": "D"
        },
        {
          "datasource": {
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_global_variables_relay_log_recovery",
          "legendFormat": "relay_log_recovery {{pod}}",
          "refId": "E"
        }
      ]
    }
  ]
}

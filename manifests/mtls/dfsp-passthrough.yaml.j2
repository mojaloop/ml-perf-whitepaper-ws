# Per-DFSP passthrough Ingress for :443 -> SDK scheme-adapter :4000.
# `fspNNN` is substituted per cluster by the mtls_dfsp role (per_fsp.yml).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dfsp-sim-fspNNN-mtls-passthrough
  namespace: dfsps
  annotations:
    nginx.ingress.kubernetes.io/ssl-passthrough: "true"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  ingressClassName: nginx
  tls:
    - hosts: [sim-fspNNN.local]
  rules:
    - host: sim-fspNNN.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: dfsp-sim-fspNNN-scheme-adapter
                port:
                  name: inboundapi
